{
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "agents": {
    "defaults": {
      "maxConcurrent": 4,
      "model": {
        "primary": "openai/gpt-5.4-mini"
      },
      "subagents": {
        "maxConcurrent": 8
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "heartbeat": {
        "every": "30m"
      },
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "tools": {
    "deny": ["exec"]
  },
  "gateway": {
    "auth": {
      "mode": "token",
      "token": "CHANGE_ME_RANDOM_TOKEN"
    }
  },
  "mcp": {
    "servers": {
      "claude-harness": {
        "command": "python3",
        "args": ["/mcp/harness_bridge.py"],
        "type": "stdio"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "YOUR_TELEGRAM_BOT_TOKEN",
      "dmPolicy": "pairing",
      "execApprovals": {
        "enabled": true
      }
    }
  },
  "skills": {
    "entries": {
      "coding-agent": {
        "enabled": false
      }
    }
  }
}
